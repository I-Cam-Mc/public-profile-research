{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/I-Cam-Mc/public-profile-research/main/schemas/job-plan.schema.json",
  "title": "Public Profile Research job plan",
  "type": "object",
  "required": ["schema_version", "research_mode", "depth", "targets"],
  "properties": {
    "schema_version": { "const": 1 },
    "research_mode": { "enum": ["insight", "bounded_census", "maximum_public_coverage"] },
    "depth": { "enum": ["quick", "standard", "deep", "maximum"] },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["platform", "canonical_url", "adapter_ids"],
        "properties": {
          "platform": { "type": "string", "minLength": 1 },
          "canonical_url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "adapter_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
