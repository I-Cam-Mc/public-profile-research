{
  "name": "public-profile-research-skill",
  "private": true,
  "version": "0.4.0",
  "description": "Open-source public-profile research skill, collector and evidence-linked report builder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/I-Cam-Mc/public-profile-research.git"
  },
  "homepage": "https://i-cam-mc.github.io/public-profile-research/",
  "keywords": [
    "agent-skill",
    "public-profile",
    "research",
    "digital-footprint",
    "evidence"
  ],
  "type": "module",
  "bin": {
    "ppr": "bin/ppr.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "playwright-core": "1.61.1"
  },
  "scripts": {
    "app": "node server/local-server.mjs",
    "research": "node bin/ppr.mjs run",
    "test": "node --test tests",
    "validate": "node scripts/verify-case.mjs",
    "validate-browser": "node scripts/verify-browser-receipt.mjs",
    "validate-visual": "node scripts/verify-visual-receipt.mjs",
    "validate-visual-review": "node scripts/verify-visual-review.mjs",
    "record-visual-review": "node scripts/record-visual-review.mjs",
    "capture-report": "node scripts/capture-report-screenshots.mjs"
  }
}
